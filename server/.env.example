# 服务端固定监听 127.0.0.1；端口应与后台代理和桌面 API Origin 一致。
SERVER_PORT=3000
# 后台浏览器访问的完整 Origin，用于校验写请求和设置会话 Cookie。
ADMIN_ORIGIN=http://127.0.0.1:5180

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sproutkin_ai

# 32 随机字节的十六进制值。已有数据库必须保留原密钥。
CONFIG_ENCRYPTION_KEY=

# 固定 admin 密码的 scrypt 哈希（salt.hex + '.' + hash.hex），迁移时写入数据库。
ADMIN_PASSWORD_HASH=
