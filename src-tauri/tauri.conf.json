{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sproutkin",
  "version": "0.1.0",
  "identifier": "com.desktoppet.plantpet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "芽伴 · Sproutkin",
        "width": 900,
        "height": 800,
        "minWidth": 700,
        "minHeight": 540,
        "visible": false
      },
      {
        "label": "pet",
        "title": "芽伴 · Sproutkin — 桌面伙伴",
        "url": "pet.html",
        "width": 240,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "shortDescription": "芽伴 · Sproutkin：植物养护与桌面陪伴",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
